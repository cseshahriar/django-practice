CREATE TABLE IF NOT EXISTS "djorm_aggregationbook" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "title" varchar(255) NOT NULL, "authors" varchar(255) NOT NULL, "average_rating" real NOT NULL, "isbn" varchar(150) NOT NULL, "isbn13" varchar(150) NOT NULL, "language_code" varchar(10) NOT NULL, "num_pages" integer NOT NULL, "ratings_count" bigint NOT NULL, "text_review_count" bigint NOT NULL, "publication_date" date NOT NULL, "publisher" varchar(150) NOT NULL);
INSERT INTO "djorm_aggregationbook" VALUES(1,'Minim explicabo Qui aliquip atque magnam cupiditate veniam quod eu porro exercitationem quis exercitation qui commodi fugiat maxime','Shahriar',39.0,'Dolore neque et eum sed et aliqua Et cillum proident esse sint nisi','Ipsa minima minus sed aperiam sed qui consectetur dolores eos','Quo et vol',19,6,5,'2021-08-30','Reprehenderit qui et aut sequi numquam incidunt magna eu ullam dolorem aliquip a');
INSERT INTO "djorm_aggregationbook" VALUES(2,'Ut a esse quis ea dignissimos quod quia','Shahriar',44.0,'Laboris et qui odit sit quia quis ipsum quaerat excepturi aute dolores ducimus aute reprehenderit sint','Aut nulla consequatur earum atque et dignissimos sed vel molestiae necessitatibus ut sequi elit ullamco facilis sed deserunt vel delectus','Sequi est',418,5,4,'2021-08-30','Hic hic rerum minus ea tenetur ea culpa voluptatem vitae inventore explicabo Fuga Voluptas neque ex sint sunt et tempora');
INSERT INTO "djorm_aggregationbook" VALUES(3,'Maxime ea non nostrum in magnam voluptatum','Shahriar',45.0,'Mollitia eos exercitationem ipsum adipisci ex exercitationem proident sint est quidem eaque dolore aliquid totam aut officia','Exercitationem ducimus molestias ad earum culpa vel non','Ut est te',313,3,6,'2021-08-30','Omnis in suscipit lorem necessitatibus rem');
INSERT INTO "djorm_aggregationbook" VALUES(4,'Rerum voluptate dolores similique harum perferendis quidem eius molestias perspiciatis aut aliquid numquam dolores','Shahriar',60.0,'Fugit at consectetur est pariatur Suscipit duis sit pariatur Vel','Officia porro fugiat quo laboriosam quaerat ut non et aut ut vel atque nobis dolores voluptatem quo','Totam dele',928,4,5,'2021-08-30','Ipsam dolore ea mollit natus sint');
